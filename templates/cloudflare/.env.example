# Copy to .env (gitignored), with your development application's values: `cargo composure dev`,
# `wrangler dev` and `cargo run --bin sync` all read it.
# Developer Portal > your app > General Information
DISCORD_PUBLIC_KEY=
# Developer Portal > your app > Bot, for the bot client (ctx.bot()) and Sync
DISCORD_TOKEN=
# For `cargo run --bin sync`; `cargo composure dev` uses the id in Cargo.toml
DISCORD_APPLICATION_ID=
