{
  "$schema": "https://unpkg.com/wrangler@4.151.0/config-schema.json",
  "name": "composure-commands-example",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-10-01",

  // worker-build compiles the crate to wasm and writes the JS shim to build/worker
  "build": {
    "command": "worker-build --release"
  },

  // GREETING is read by /greet through the Worker State
  "vars": {
    "GREETING": "Hello",
    // Needed by bot_client() outside Interactions (the cron trigger below)
    "DISCORD_APPLICATION_ID": ""
    // "STATUS_CHANNEL_ID": "<channel id>" enables the daily heartbeat
  },

  // Runs the scheduled() handler daily at 09:00 UTC
  "triggers": {
    "crons": ["0 9 * * *"]
  }

  // DISCORD_PUBLIC_KEY (required) and DISCORD_TOKEN (for REST commands) are secrets:
  // `npx wrangler secret put <NAME>`, or `.dev.vars` for `wrangler dev`
}
