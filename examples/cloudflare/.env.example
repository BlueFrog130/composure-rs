# Copy to .env (gitignored), with a development application's values: `cargo composure dev`,
# `wrangler dev` and the sync bin all read it. Variables already set in the environment win.
DISCORD_PUBLIC_KEY=
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Guild ids for #[command(scope = "dev")], comma-separated
COMPOSURE_SCOPE_DEV=
